{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Source Control SDK",
  "description": "git, git-lfs and the GitHub CLI for cpak development environments.",
  "version": "1.0.0",
  "image": "ghcr.io/containerpak/sdk-scm@sha256:d097232f9a70d5163deb694625907352f704b2bd49ea4e60b02f7eb9484e9ab2",
  "binaries": [
    "/usr/bin/git",
    "/usr/bin/git-lfs",
    "/usr/bin/gh",
    "/usr/bin/ssh",
    "/usr/bin/ssh-add",
    "/usr/bin/ssh-keygen"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "scm",
    "slot": "sdk.scm",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
